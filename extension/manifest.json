{
  "manifest_version": 3,
  "name": "Hotel Cali Timetable Sync",
  "version": "1.0.0",
  "description": "Every hour, copies the MICA class timetable from SharePoint into the Hotel Cali app.",
  "permissions": [
    "alarms",
    "offscreen",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://micaschoolofideas-my.sharepoint.com/*",
    "https://lnrfzkqrrnxvfhrikdyk.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hotel Cali timetable sync",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}